# Copy to .env and adjust. Docker Compose reads .env automatically.
# Every variable is optional; the value shown is the default used when unset.

# Host port published for the API (the container always listens on 8081)
HOST_PORT=8081

# Scraper log level: DEBUG, INFO, WARNING, ERROR
DTEK_LOG_LEVEL=INFO

# Emergency notice filter: stem of your district as written in the site notice,
# e.g. "Голосіїв" matches "Голосіївського". Empty = any emergency notice applies.
# DTEK_DISTRICT=

# Site settings (uncomment to override the built-in defaults)
# DTEK_URL=https://www.dtek-kem.com.ua/ua/shutdowns
# DTEK_TIMEZONE=Europe/Kyiv
# DTEK_LOCALE=uk-UA
# DTEK_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
# DTEK_NAV_TIMEOUT_MS=45000
# DTEK_ELEMENT_TIMEOUT_MS=8000
